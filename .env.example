# Copy to .env and `export` the values (or use your shell profile). Nothing here is required for search/build.

# Contact (e-mail or URL) sent in the User-Agent so Wikimedia can reach you if your client misbehaves.
HISTPOSTS_CONTACT=

# Only for `histposts caption` (Claude API). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=
# HISTPOSTS_MODEL=claude-opus-5

# Optional extra sources for `histposts search`.
EUROPEANA_KEY=
NARA_KEY=
SMITHSONIAN_KEY=

# Optional: path to the Real-ESRGAN binary if it is not in tools/realesrgan/.
# HISTPOSTS_REALESRGAN=
